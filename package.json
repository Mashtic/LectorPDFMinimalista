{
  "name": "app",
  "version": "1.0.0",
  "description": "Lector PDF Minimalista",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "live": "nodemon --ext js,css,html --exec electron .",
    "build": "electron-builder --linux --win",
    "build:win": "electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mashtic/LectorPDFMinimalista.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Mashtic/LectorPDFMinimalista/issues"
  },
  "homepage": "https://github.com/Mashtic/LectorPDFMinimalista#readme",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.disin.folio",
    "productName": "Folio",
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF Document",
          "description": "PDF Document",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
